# ---- Speech to text ----
# https://console.deepgram.com  ->  API Keys
DEEPGRAM_API_KEY=

# ---- LLM ----
# https://console.anthropic.com  ->  API Keys
ANTHROPIC_API_KEY=
WREN_LLM_MODEL=claude-sonnet-5

# ---- Text to speech ----
# https://play.cartesia.ai  ->  API Keys
CARTESIA_API_KEY=
CARTESIA_VOICE_ID=

# ---- Embeddings ----
# Provider for knowledge base embeddings: "openai" or "local"
EMBEDDINGS_PROVIDER=openai
EMBEDDINGS_MODEL=text-embedding-3-small
OPENAI_API_KEY=

# ---- Database ----
POSTGRES_USER=wren
POSTGRES_PASSWORD=wren
POSTGRES_DB=wren
DATABASE_URL=postgresql://wren:wren@db:5432/wren

# ---- Host port mapping ----
# Defaults avoid the usual 5432/8000/5173 so Wren can run beside other stacks.
DB_HOST_PORT=5433
API_HOST_PORT=8001
AGENT_HOST_PORT=7860
WEB_HOST_PORT=5174

# ---- Service wiring ----
API_BASE_URL=http://api:8000
AGENT_PORT=7860
LOG_LEVEL=INFO

# ---- Observability (optional; leave blank to disable) ----
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=http://langfuse:3000
