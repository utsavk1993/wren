# ---- Speech, both directions ----
# https://console.deepgram.com  ->  API Keys
#
# One service for hearing and speaking. The alternative was one company for
# each, which meant two accounts and two bills, and left the speaking half with
# an allowance of about thirty calls a month.
DEEPGRAM_API_KEY=
# Any Aura voice. Changing it changes who the caller hears.
DEEPGRAM_VOICE=aura-2-thalia-en

# ---- LLM ----
# https://console.anthropic.com  ->  API Keys
ANTHROPIC_API_KEY=
WREN_LLM_MODEL=claude-haiku-4-5
# Thinking is on by default on this model. Held low rather than switched off:
# on a call the wait before the first word matters more than the depth of the
# reasoning, and disabling thinking outright can push the model into writing
# tool calls as visible text instead of calling them.
WREN_LLM_EFFORT=low


# ---- Embeddings ----
# "local" runs the model in-process with no API key and nothing leaving the
# machine, which is the default so the knowledge base can be built by anyone.
# "openai" uses a hosted model and needs a key below.
#
# The two produce vectors of different widths, and the width is part of the
# database schema. Switching provider means rebuilding the table and
# re-ingesting; the ingestion step refuses to run rather than write vectors the
# column cannot hold.
EMBEDDINGS_PROVIDER=local
EMBEDDINGS_MODEL=BAAI/bge-small-en-v1.5
OPENAI_API_KEY=

# ---- Database ----
POSTGRES_USER=wren
POSTGRES_PASSWORD=wren
POSTGRES_DB=wren
DATABASE_URL=postgresql://wren:wren@db:5432/wren

# ---- Host port mapping ----
# Defaults avoid the usual 5432/8000/5173 so Wren can run beside other stacks.
DB_HOST_PORT=5433
API_HOST_PORT=8001
AGENT_HOST_PORT=7860
WEB_HOST_PORT=5174

# ---- Service wiring ----
API_BASE_URL=http://api:8000
AGENT_PORT=7860
LOG_LEVEL=INFO
# "text" while developing, because a person is reading it. "json" once deployed,
# because a machine is. Either way the passcode, phone numbers and email
# addresses are stripped on the way out.
LOG_FORMAT=text

# ---- Observability (optional; leave blank to disable) ----
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=http://langfuse:3000

# ---- Salesforce (customer accounts and support cases) ----
# Authentication uses the OAuth client credentials flow: the service exchanges
# its consumer key and secret for an access token directly, with no browser
# redirect and no signed-in user. The app's callback URL is a required field on
# the setup form but is never actually called.
#
# Configured under Setup -> External Client App Manager. Enabling the flow takes
# two passes: tick it on the app's Settings tab, then enable it again under
# Policies -> OAuth Policies and attach a Run As user. That user is the identity
# the token acts as, and its permissions bound what the integration can reach.
# New credentials take roughly ten minutes to propagate; token requests before
# then fail in a way that looks like a misconfiguration.
#
# The instance URL must not carry a trailing slash.
SALESFORCE_INSTANCE_URL=
SALESFORCE_CLIENT_ID=
SALESFORCE_CLIENT_SECRET=

# ---- Supabase (device telemetry) ----
# Holds live device state: status, battery level and last contact time.
#
# Use a secret key (sb_secret_...), not a publishable one. The secret key runs
# server-side, bypasses row-level security and can read and write any row, so it
# must never reach the browser client or any bundle shipped to a user.
#
# These replace the older anon and service_role keys, which are being retired.
# Unlike service_role, several secret keys can exist at once and be revoked
# individually, so rotating one does not take every other integration down with
# it.
SUPABASE_URL=
SUPABASE_SECRET_KEY=

